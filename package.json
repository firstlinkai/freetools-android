{
  "name": "freetools-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ffmpeg.mjs && tsc --noEmit && vite build && node scripts/check-offline.mjs",
    "build:fast": "node scripts/copy-ffmpeg.mjs && vite build && node scripts/check-offline.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.4",
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
